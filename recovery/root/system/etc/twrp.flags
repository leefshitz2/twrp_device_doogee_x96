# Dynamic Partitions
/system                 ext4     /dev/block/mapper/system                   flags=display="System";slotselect;backup=1;wipeingui
/system_ext             ext4     /dev/block/mapper/system_ext               flags=display="System_Ext";slotselect;backup=1;wipeingui
/vendor                 ext4     /dev/block/mapper/vendor                   flags=display="Vendor";slotselect;backup=1;wipeingui
/product                ext4     /dev/block/mapper/product                  flags=display="Product";slotselect;backup=1;wipeingui

# Dynamic Partitions Images
/system_image           emmc     /dev/block/mapper/system                   flags=backup=1;flashimg=1;display="System Image";slotselect
/system_ext_image       emmc     /dev/block/mapper/system_ext               flags=backup=1;flashimg=1;display="System_Ext Image";slotselect
/vendor_image           emmc     /dev/block/mapper/vendor                   flags=backup=1;flashimg=1;display="Vendor Image";slotselect
/product_image          emmc     /dev/block/mapper/product                  flags=backup=1;flashimg=1;display="Product Image";slotselect
/super                  emmc     /dev/block/by-name/super                   flags=backup=1;flashimg=1;display="Super Image"

# Bootloader & Security Partitions
/spl                    emmc     /dev/block/mmcblk0boot0                    flags=display="SPL";backup=1
/spl_bk                 emmc     /dev/block/mmcblk0boot1                    flags=display="SPL_BK";backup=1
/uboot                  emmc     /dev/block/by-name/uboot                   flags=backup=1;display="UBoot";slotselect
/uboot_log              emmc     /dev/block/by-name/uboot_log               flags=backup=1;display="UBoot Log"
/sml                    emmc     /dev/block/by-name/sml                     flags=backup=1;display="SML";slotselect
/tos                    emmc     /dev/block/by-name/trustos                 flags=backup=1;display="TrustOS";slotselect
/teecfg                 emmc     /dev/block/by-name/teecfg                  flags=backup=1;display="TEECFG";slotselect
/vbmeta                 emmc     /dev/block/by-name/vbmeta                  flags=backup=1;display="VBMeta";slotselect;flashimg=1
/vbmeta_system          emmc     /dev/block/by-name/vbmeta_system           flags=backup=1;display="VBMeta System";slotselect;flashimg=1
/vbmeta_vendor          emmc     /dev/block/by-name/vbmeta_vendor           flags=backup=1;display="VBMeta Vendor";slotselect;flashimg=1
/vbmeta_product         emmc     /dev/block/by-name/vbmeta_product          flags=backup=1;display="VBMeta Product";slotselect;flashimg=1
/vbmeta_system_ext      emmc     /dev/block/by-name/vbmeta_system_ext       flags=backup=1;display="VBMeta System_Ext";slotselect;flashimg=1
/dtbo                   emmc     /dev/block/by-name/dtbo                    flags=backup=1;display="DTBO";slotselect;flashimg=1
/misc                   emmc     /dev/block/by-name/misc                    flags=display="Misc"
/miscdata               emmc     /dev/block/by-name/miscdata                flags=backup=1;display="MiscData"
/boot                   emmc     /dev/block/by-name/boot                    flags=backup=1;display="Boot";slotselect;flashimg=1
/persist                emmc     /dev/block/by-name/persist                 flags=backup=1;display="Persist"
/logo                   emmc     /dev/block/by-name/logo                    flags=backup=1;display="Logo"
/fbootlogo              emmc     /dev/block/by-name/fbootlogo               flags=backup=1;display="Fastboot Logo"

# Modem & Telephony NVRAM
/ltedsp                 emmc     /dev/block/by-name/l_ldsp                  flags=backup=1;subpartitionof=/ltemodem;slotselect
/ltegdsp                emmc     /dev/block/by-name/l_gdsp                  flags=backup=1;subpartitionof=/ltemodem;slotselect
/ltemodem               emmc     /dev/block/by-name/l_modem                 flags=backup=1;display="Modem";slotselect
/ltedeltanv             emmc     /dev/block/by-name/l_deltanv               flags=backup=1;subpartitionof=/ltemodem;slotselect
/ltefixnv1              emmc     /dev/block/by-name/l_fixnv1                flags=backup=1;subpartitionof=/ltemodem
/ltefixnv2              emmc     /dev/block/by-name/l_fixnv2                flags=backup=1;subpartitionof=/ltemodem
/lteruntimenv1          emmc     /dev/block/by-name/l_runtimenv1            flags=backup=1;subpartitionof=/ltemodem
/lteruntimenv2          emmc     /dev/block/by-name/l_runtimenv2            flags=backup=1;subpartitionof=/ltemodem
/wcnmodem               emmc     /dev/block/by-name/wcnmodem                flags=backup=1;display="WCN Modem";slotselect
/gnssmodem              emmc     /dev/block/by-name/gpsgl                   flags=backup=1;display="GNSS GL";slotselect
/gnssbdmodem            emmc     /dev/block/by-name/gpsbd                   flags=backup=1;display="GNSS BD";slotselect
/pmsys                  emmc     /dev/block/by-name/pm_sys                  flags=backup=1;display="PMSYS";slotselect

# Additional Ext4 Partitions
/socko                  ext4     /dev/block/by-name/socko                   flags=backup=1;display="Socko";slotselect
/odmko                  ext4     /dev/block/by-name/odmko                   flags=backup=1;display="Odmko";slotselect
/prodnv                 ext4     /dev/block/by-name/prodnv                  flags=backup=1;display="ProdNV"
/metadata               ext4     /dev/block/by-name/metadata                flags=backup=1;display="Metadata"
/data                   f2fs     /dev/block/by-name/userdata                flags=display="Data";wipeingui

# Removable storage
/external_sd            auto     /dev/block/mmcblk1p1    /dev/block/mmcblk1  flags=fsflags=utf8;storage;wipeingui;removable
/usb-otg                auto     /dev/block/sda1         /dev/block/sda      flags=fsflags=utf8;storage;wipeingui;removable
