# Images
/system_image           emmc     /dev/block/mapper/system                   flags=backup=1;flashimg=1;display="System Image"
/system_ext_image       emmc     /dev/block/mapper/system_ext               flags=backup=1;flashimg=1;display="System_Ext Image"
/vendor_image           emmc     /dev/block/mapper/vendor                   flags=backup=1;flashimg=1;display="Vendor Image"
/product_image          emmc     /dev/block/mapper/product                  flags=backup=1;flashimg=1;display="Product Image"
/super                  emmc     /dev/block/by-name/super                   flags=backup=1;flashimg=1;display="Super Image"

# Other
/spl                    emmc     /dev/block/mmcblk0boot0
/spl_bk                 emmc     /dev/block/mmcblk0boot1
/uboot                  emmc     /dev/block/by-name/uboot                   flags=slotselect
/uboot_log              emmc     /dev/block/by-name/uboot_log               flags=backup=1
/sml                    emmc     /dev/block/by-name/sml                     flags=slotselect
/tos                    emmc     /dev/block/by-name/trustos                 flags=slotselect
/teecfg                 emmc     /dev/block/by-name/teecfg                  flags=slotselect
/vbmeta                 emmc     /dev/block/by-name/vbmeta                  flags=backup=1;slotselect
/dtbo                   emmc     /dev/block/by-name/dtbo                    flags=backup=1;slotselect
/misc                   emmc     /dev/block/by-name/misc
/boot                   emmc     /dev/block/by-name/boot                    flags=backup=1;slotselect
/persist                emmc     /dev/block/by-name/persist                 flags=backup=1
/logo                   emmc     /dev/block/by-name/logo                    flags=backup=1
/socko                  ext4     /dev/block/by-name/socko                   flags=backup=1;slotselect
/odmko                  ext4     /dev/block/by-name/odmko                   flags=backup=1;slotselect
/prodnv                 ext4     /dev/block/by-name/prodnv                  flags=backup=1

# Removable storage
/external_sd            auto     /dev/block/mmcblk1p1    /dev/block/mmcblk1  flags=storage;wipeingui;removable;fsflags="utf8"
/usb-otg                auto     /dev/block/sda1         /dev/block/sda      flags=storage;wipeingui;removable;fsflags="utf8"